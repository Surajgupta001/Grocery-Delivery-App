{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",

    "module": "Preserve",
    "moduleResolution": "bundler",

    "allowJs": false,
    "noEmit": true,

    "strict": true,
    "skipLibCheck": true,

    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,

    "types": ["bun", "node"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "middlewares/**/*.ts",
    "config/**/*.ts",
    "types/**/*.d.ts",
    "prisma.config.ts",
    "seed.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
